---
interface Props {
  name: string;
  color: string | undefined;
  href: string;
}

const { name, color: backgroundColor, href } = Astro.props;

const image = "/social/" + name.toLowerCase() + ".svg";
---

<a href={href} class="social-link" target="_blank">
  <img src={image} />
</a>

<style define:vars={{ backgroundColor }}>
  .social-link {
    padding: 5px;
    background-image: var(--backgroundColor);
    background-color: var(--backgroundColor);
    background-size: 400%;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: all 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    aspect-ratio: 1 / 1;
  }
  .social-link:hover {
    scale: 115%;
  }
  .social-link:active {
    scale: 90%;
  }
  .social-link img {
    width: 100%;
    height: 100%;
  }
</style>
