---
import ProjectPage from "../../components/ProjectPage.astro";
---

<ProjectPage
  name="ncsuguessr"
  title="ncsuguessr"
  description="A geoguessr-inspired game for the NC State community made with React Native."
>
  <div class="button-row">
    <a
      class="button-external-emphasis"
      href="https://github.com/NCSU-App-Development-Club/ncsuguessr"
      target="_blank">View on GitHub</a
    >
    <a class="button-external" href="https://appdevncsu.org/" target="_blank"
      >Visit App Development Club</a
    >
  </div>
  <hr />
  <h3>About</h3>
  <p>
    ncsuguessr is a mobile app that helps users learn the NC State campus and
    test their knowledge through fun, interactive puzzles. Each day, a new game
    is available, and users must guess the location of a specific landmark.
  </p>
  <p>
    As the team lead, I'm responsible for planning workshops and events,
    providing constructive feedback on code submissions, and building a sense of
    community in my team. Our goal is to release the app by the end of the year.
  </p>
</ProjectPage>
